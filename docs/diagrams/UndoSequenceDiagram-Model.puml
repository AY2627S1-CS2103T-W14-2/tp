@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant ":ModelManager" as Model MODEL_COLOR
participant "undoHistory:Deque<AddressBook>" as History MODEL_COLOR
participant "addressBook:AddressBook" as AddressBook MODEL_COLOR

[-> Model : undo()
Model -> Model : canUndo()
Model -> History : isEmpty()
History --> Model : empty
alt empty
    [<-- Model : IllegalStateException
else snapshot available
    Model -> History : pop()
    History --> Model : latest snapshot
    Model -> AddressBook : resetData(snapshot)
    AddressBook --> Model
    Model -> Model : updateFilteredPersonList(PREDICATE_SHOW_ALL_PERSONS)
    note over Model, AddressBook
        Main list shows all contacts; recent-search predicate is retained.
        Observable-list listeners refresh both views and SearchHistory.
        No search-history snapshot is restored by undo.
    end note
    [<-- Model : restored (one snapshot removed)
end
@enduml
