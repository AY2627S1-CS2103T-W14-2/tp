@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant "command:RenameProjectCommand" as Command LOGIC_COLOR
participant ":Model" as Model MODEL_COLOR
participant ":Storage" as Storage STORAGE_COLOR

[-> Logic : execute(input)
activate Logic
Logic -> Parser : parseCommand(input)
Parser --> Logic : command
Logic -> Model : getAddressBook()
Model --> Logic : before snapshot
Logic -> Command : execute(model)
activate Command
Command -> Model : getAddressBook()
Model --> Command : all contacts
Command -> Command : validate and build replacement
alt invalid source or no changes
    Command --> Logic : CommandException
    [<-- Logic : error (no save or undo entry)
else rename or merge
    Command -> Model : setAddressBook(replacement)
    note right of Model
        Keep the current filter.
        Re-evaluate matching contacts.
    end note
    Command --> Logic : result (includes undo reminder)
    Logic -> Model : saveUndoState(before)
    Logic -> Storage : saveAddressBook(current data)
    alt save fails
        Storage --> Logic : IOException
        [<-- Logic : save error (in-memory change remains undoable)
    else save succeeds
        Storage --> Logic
        [<-- Logic : success
    end
end
deactivate Command
deactivate Logic
@enduml
