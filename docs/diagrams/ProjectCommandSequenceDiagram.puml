@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant "command:ProjectCommand" as Command LOGIC_COLOR
participant ":Model" as Model MODEL_COLOR
participant ":Storage" as Storage STORAGE_COLOR

[-> Logic : execute(input)
activate Logic
Logic -> Parser : parseCommand(input)
Parser --> Logic : command
Logic -> Model : getAddressBook()
Model --> Logic : before snapshot
Logic -> Command : execute(model)
activate Command
Command -> Model : getFilteredPersonList()
Model --> Command : displayed contacts
Command -> Command : validate all selections
Command -> Command : build replacement contacts

alt invalid index or duplicate association
    Command --> Logic : CommandException
    [<-- Logic : error (no contact changed)
else all selections valid
    loop each selected contact
        Command -> Model : setPerson(original, replacement)
    end
    Command --> Logic : result
    Logic -> Model : saveUndoState(before)
    Logic -> Storage : saveAddressBook(current data)
    [<-- Logic : success
end
deactivate Command
deactivate Logic
@enduml
