@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant ":LogicManager" as Logic LOGIC_COLOR
participant ":UndoCommand" as Command LOGIC_COLOR
participant ":Model" as Model MODEL_COLOR
participant ":Storage" as Storage STORAGE_COLOR

[-> Logic : execute("undo")
ref over Logic, Command
    AddressBookParser.parseCommand("undo")
    creates UndoCommand directly (no command parser)
end ref
Logic -> Model : canUndo()
Model --> Logic : available
alt no undo state
    Logic -> Command : execute(model)
    Command -> Model : canUndo()
    Model --> Command : false
    Command --> Logic : CommandException
    [<-- Logic : "No command to undo."
else undo state available
    Logic -> Model : getUndoState()
    Model --> Logic : copy of latest snapshot
    Logic -> Storage : saveAddressBook(snapshot)
    alt save fails
        Storage --> Logic : IOException
        [<-- Logic : CommandException
        note over Logic, Model : Contacts, filters and undo history remain unchanged.
    else save succeeds
        Storage --> Logic
        Logic -> Command : execute(model)
        Command -> Model : canUndo()
        Model --> Command : true
        Command -> Model : undo()
        ref over Model : Restore latest snapshot (model diagram)
        Model --> Command
        Command --> Logic : result
        [<-- Logic : "Last command undone."
    end
end
@enduml
